POSTGRES_USER=recipejoe
POSTGRES_PASSWORD=recipejoe
POSTGRES_DB=recipejoe
POSTGRES_PORT=5432
API_PORT=5080
WEB_PORT=8080

# Video Import LLM (read by `just dev` and passed to the backend container; never used in CI).
# Default: Gemma on host Ollama (`ollama pull gemma4:26b`), free. `just dev` points the host-run API at localhost:11434 automatically.
# To use OpenRouter instead, uncomment and set the key (.env is git-ignored):
# Llm__Provider=OpenRouter
# Llm__ApiKey=sk-or-...
# Optional: Llm__Model=google/gemma-4-26b-a4b-it
# Optional: Llm__BaseUrl=http://localhost:11434
# Optional: Llm__Timeout=00:03:00
# Optional: Llm__ContextTokens=32768
