POSTGRES_USER=recipejoe
POSTGRES_PASSWORD=recipejoe
POSTGRES_DB=recipejoe
POSTGRES_PORT=5432
API_PORT=5080
WEB_PORT=8080

# Video Import LLM: OpenRouter (read by `just dev` and passed to the backend container; never used in CI).
# Required: uncomment and set the key (.env is git-ignored).
# Llm__ApiKey=sk-or-...
# Optional: Llm__Model=mistralai/mistral-medium-3-5
# Optional: Llm__BaseUrl=https://openrouter.ai/api/v1
# Optional: Llm__Timeout=00:03:00
# Optional: Llm__RecipeCheckModel=google/gemini-3.1-flash-lite  (model for the "is there a recipe" pre-call; default: Llm__Model)
# Optional: Llm__PinnedProviders=Google AI Studio  (OpenRouter upstream providers, comma separated, in order; no fallback to others; default: OpenRouter chooses)
