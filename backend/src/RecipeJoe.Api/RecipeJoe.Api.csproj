<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="YoutubeExplode" />
  </ItemGroup>

  <PropertyGroup>
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../..</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Video/RecipeExtractionPrompt.md" LogicalName="RecipeExtractionPrompt.md" />
    <EmbeddedResource Include="Video/RecipeCheckPrompt.md" LogicalName="RecipeCheckPrompt.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RecipeJoe.UnitTests" />
    <InternalsVisibleTo Include="RecipeJoe.ContractTests" />
    <InternalsVisibleTo Include="RecipeJoe.IntegrationTests" />
    <InternalsVisibleTo Include="RecipeJoe.GoldenTests" />
    <InternalsVisibleTo Include="RecipeJoe.Sweep" />
  </ItemGroup>

</Project>
