{
  "openapi": "3.1.1",
  "info": {
    "title": "RecipeJoe.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/imports": {
      "post": {
        "tags": [
          "ImportsEndpoints"
        ],
        "operationId": "StartImport",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartImportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportsProblem"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "ImportsEndpoints"
        ],
        "operationId": "ListImports",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ImportDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/imports/{id}/retry": {
      "post": {
        "tags": [
          "ImportsEndpoints"
        ],
        "operationId": "RetryImport",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/imports/{id}": {
      "delete": {
        "tags": [
          "ImportsEndpoints"
        ],
        "operationId": "DismissImport",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/recipes": {
      "get": {
        "tags": [
          "RecipeJoe.Api"
        ],
        "operationId": "ListRecipes",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecipeSummaryDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/recipes/{id}": {
      "get": {
        "tags": [
          "RecipeJoe.Api"
        ],
        "operationId": "GetRecipe",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "tags": [
          "RecipeJoe.Api"
        ],
        "operationId": "DeleteRecipe",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/recipes/{id}/image": {
      "get": {
        "tags": [
          "RecipeJoe.Api"
        ],
        "operationId": "GetRecipeImage",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "byte"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "byte"
                }
              },
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "byte"
                }
              },
              "image/gif": {
                "schema": {
                  "type": "string",
                  "format": "byte"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ImportDto": {
        "required": [
          "id",
          "url",
          "kind",
          "state",
          "stage",
          "failure"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ImportKind"
          },
          "state": {
            "$ref": "#/components/schemas/ImportState"
          },
          "stage": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ImportStage"
              }
            ]
          },
          "failure": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ImportFailure"
              }
            ]
          }
        }
      },
      "ImportFailure": {
        "enum": [
          "InvalidUrl",
          "Unreachable",
          "Blocked",
          "NotFound",
          "BadResponse",
          "ForbiddenAddress",
          "NoRecipe",
          "NoCaptions",
          "LlmUnavailable",
          "LlmBadOutput",
          "VideoTooLong",
          "SaveFailed",
          null
        ]
      },
      "ImportKind": {
        "enum": [
          "Web",
          "Video"
        ]
      },
      "ImportsProblem": {
        "required": [
          "type",
          "title",
          "status",
          "kind"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "kind": {
            "$ref": "#/components/schemas/ImportFailure"
          }
        }
      },
      "ImportStage": {
        "enum": [
          "Fetching",
          "Extracting",
          "Saving",
          null
        ]
      },
      "ImportState": {
        "enum": [
          "Pending",
          "Failed"
        ]
      },
      "RecipeDto": {
        "required": [
          "id",
          "title",
          "servings",
          "prepMinutes",
          "cookMinutes",
          "totalMinutes",
          "ingredientLines",
          "steps",
          "sourceUrl",
          "imageUrl",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "servings": {
            "type": [
              "null",
              "string"
            ]
          },
          "prepMinutes": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "cookMinutes": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "totalMinutes": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "ingredientLines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceUrl": {
            "type": "string"
          },
          "imageUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RecipeSummaryDto": {
        "required": [
          "id",
          "title",
          "sourceUrl",
          "hasImage",
          "isNew"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string"
          },
          "hasImage": {
            "type": "boolean"
          },
          "isNew": {
            "type": "boolean"
          }
        }
      },
      "StartImportRequest": {
        "required": [
          "url"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "ImportsEndpoints"
    },
    {
      "name": "RecipeJoe.Api"
    }
  ]
}